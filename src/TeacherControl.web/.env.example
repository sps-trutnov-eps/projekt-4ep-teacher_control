# Nic z tohohle nemusíš nastavovat, aby appka nastartovala.
# Zkopíruj do .env.local, jen když chceš změnit výchozí chování.

# Základ URL backend API. V dev módu jde přes Vite proxy na http://localhost:5000.
VITE_API_BASE_URL=/api

# Ve vývoji jedou MSW mocky defaultně. Odkomentuj, jen když chceš jet proti reálnému backendu.
#VITE_USE_MOCKS=false
