{
  "openapi": "3.0.3",
  "info": {
    "title": "TeacherControl API (PLACEHOLDER)",
    "version": "0.0.0-placeholder",
    "description": "DOČASNÝ PLACEHOLDER, NENÍ TO KONTRAKT. Vznikl při bootstrapu frontendu, aby šlo spustit `pnpm gen:api` a aby referenční featura Rating měla typy. Backend (Egmont) tenhle soubor nahradí schématem vyexportovaným z ASP.NET Core Web API. Neupravuj ho ručně kvůli novým endpointům, dokud ho backend nepřevezme."
  },
  "servers": [{ "url": "/api" }],
  "paths": {
    "/ratings": {
      "get": {
        "operationId": "getRatings",
        "tags": ["Rating"],
        "parameters": [
          {
            "name": "subject",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Seznam hodnocení",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Rating" } }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createRating",
        "tags": ["Rating"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateRatingRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vytvořené hodnocení",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Rating" } }
            }
          },
          "400": {
            "description": "Neplatný vstup",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Rating": {
        "type": "object",
        "required": ["id", "subject", "score", "authorName", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "subject": { "type": "string" },
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "comment": { "type": "string", "nullable": true },
          "authorName": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateRatingRequest": {
        "type": "object",
        "required": ["subject", "score"],
        "properties": {
          "subject": { "type": "string" },
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "comment": { "type": "string", "nullable": true }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
