  "components": {
    "schemas": {
      "CreateReviewRequest": {
        "required": [
          "teacherId",
          "title",
          "content",
          "rating"
        ],
        "type": "object",
        "properties": {
          "teacherId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          }
        }
      },
      "SubmitLateArrivalRequest": {
        "required": [
          "minutes"
        ],
        "type": "object",
        "properties": {
          "minutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "SubmitMoodRequest": {
        "required": [
          "value"
        ],
        "type": "object",
        "properties": {
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          }
        }
      },
      "TeacherAbstenceDto": {
        "required": [
          "teacherId",
          "name",
          "photoUrl",
          "rating",
          "mood",
          "lateArrivalMinutesToday"
        ],
        "type": "object",
        "properties": {
          "teacherId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "photoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "float"
          },
          "mood": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          },
          "lateArrivalMinutesToday": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "UpdateReviewRequest": {
        "required": [
          "title",
          "content",
          "rating"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "rating": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          }
        }
      },
      "TeacherAwardDto": {
        "required": [
          "award",
          "year"
        ],
        "type": "object",
        "properties": {
          "award": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "TeacherListItemDto": {
        "required": [
          "id",
          "full_name",
          "image_url",
          "review"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "full_name": {
            "type": "string"
          },
          "image_url": {
            "type": [
              "null",
              "string"
            ]
          },
          "review": {
            "type": [
              "null",
              "number"
            ],
            "format": "float"
          }
        }
      },
      "TeacherProfileResponse": {
        "required": [
          "full_name",
          "bio",
          "review",
          "abstention",
          "binginess",
          "awards"
        ],
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string"
          },
          "image_url": {
            "type": [
              "null",
              "string"
            ]
          },
          "bio": {
            "type": "string"
          },
          "review": {
            "type": "number",
            "format": "float"
          },
          "abstention": {
            "type": "number",
            "format": "float"
          },
          "binginess": {
            "type": "number",
            "format": "float"
          },
          "awards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeacherAwardDto"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Rating"
