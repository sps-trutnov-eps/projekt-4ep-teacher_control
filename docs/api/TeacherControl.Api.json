{
  "openapi": "3.1.1",
  "info": {
    "title": "TeacherControl.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bingo/daily-winner": {
      "get": {
        "tags": [
          "TeacherBingo"
        ],
        "summary": "Get today's daily bingo winner",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBingoWinnerDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBingoWinnerDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBingoWinnerDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/daily-winner/claim": {
      "post": {
        "tags": [
          "TeacherBingo"
        ],
        "summary": "Claim today's daily bingo winner",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimDailyBingoWinnerRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimDailyBingoWinnerRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimDailyBingoWinnerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBingoWinnerDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBingoWinnerDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBingoWinnerDto"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBingoWinnerDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBingoWinnerDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBingoWinnerDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/board": {
      "get": {
        "tags": [
          "TeacherBingo"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoardDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoardDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoardDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/board/new": {
      "post": {
        "tags": [
          "TeacherBingo"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBingoBoardRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBingoBoardRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBingoBoardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoardDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoardDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoardDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/cells/{cellId}/toggle": {
      "post": {
        "tags": [
          "TeacherBingo"
        ],
        "parameters": [
          {
            "name": "cellId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ToggleBingoCellDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToggleBingoCellDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToggleBingoCellDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/quotes": {
      "get": {
        "tags": [
          "TeacherBingo"
        ],
        "parameters": [
          {
            "name": "teacherId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeacherQuoteDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeacherQuoteDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeacherQuoteDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "TeacherBingo"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTeacherQuoteRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTeacherQuoteRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTeacherQuoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherQuoteDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherQuoteDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherQuoteDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/stats": {
      "get": {
        "tags": [
          "TeacherBingo"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStatsDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStatsDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStatsDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/stats/reset": {
      "post": {
        "tags": [
          "TeacherBingo"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStatsDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStatsDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStatsDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BingoBoardDto": {
        "required": [
          "id",
          "userId",
          "gridSize",
          "cells",
          "bingoCount",
          "isCompleted",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "gridSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BingoCellDto"
            }
          },
          "bingoCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isCompleted": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "BingoCellDto": {
        "required": [
          "id",
          "row",
          "col",
          "quote",
          "isMarked"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "row": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "col": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "quote": {
            "$ref": "#/components/schemas/TeacherQuoteDto"
          },
          "isMarked": {
            "type": "boolean"
          }
        }
      },
      "ClaimDailyBingoWinnerRequest": {
        "required": [
          "boardId",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "boardId": {
            "maxLength": 12,
            "minLength": 0,
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "displayName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "CreateBingoBoardRequest": {
        "type": "object",
        "properties": {
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 3
          },
          "teacherIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateTeacherQuoteRequest": {
        "required": [
          "teacherId",
          "teacherName",
          "quote"
        ],
        "type": "object",
        "properties": {
          "teacherId": {
            "type": "string"
          },
          "teacherName": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      },
      "DailyBingoWinnerDto": {
        "required": [
          "userId",
          "displayName",
          "boardId",
          "date",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "boardId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TeacherQuoteDto": {
        "required": [
          "id",
          "teacherId",
          "teacherName",
          "quote"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "teacherId": {
            "type": "string"
          },
          "teacherName": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      },
      "ToggleBingoCellDto": {
        "required": [
          "board",
          "newBingoAchieved",
          "totalBingos"
        ],
        "type": "object",
        "properties": {
          "board": {
            "$ref": "#/components/schemas/BingoBoardDto"
          },
          "newBingoAchieved": {
            "type": "boolean"
          },
          "totalBingos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "UserBingoStatsDto": {
        "required": [
          "userId",
          "totalBingos",
          "completedBoards"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "totalBingos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "completedBoards": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "TeacherBingo"
    }
  ]
}