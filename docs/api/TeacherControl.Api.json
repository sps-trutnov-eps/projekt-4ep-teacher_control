{
  "openapi": "3.1.1",
  "info": {
    "title": "TeacherControl.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bingo/board": {
      "get": {
        "tags": [
          "TeacherBingo"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoard"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoard"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoard"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/board/new": {
      "post": {
        "tags": [
          "TeacherBingo"
        ],
        "parameters": [
          {
            "name": "size",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoard"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoard"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BingoBoard"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/cells/{cellId}/toggle": {
      "post": {
        "tags": [
          "TeacherBingo"
        ],
        "parameters": [
          {
            "name": "cellId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ToggleCellResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToggleCellResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToggleCellResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/quotes": {
      "get": {
        "tags": [
          "TeacherBingo"
        ],
        "parameters": [
          {
            "name": "teacherId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeacherQuote"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeacherQuote"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeacherQuote"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "TeacherBingo"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQuoteRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQuoteRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQuoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherQuote"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherQuote"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherQuote"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/stats": {
      "get": {
        "tags": [
          "TeacherBingo"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStats"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStats"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStats"
                }
              }
            }
          }
        }
      }
    },
    "/api/bingo/stats/reset": {
      "post": {
        "tags": [
          "TeacherBingo"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStats"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStats"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserBingoStats"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BingoBoard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "gridSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BingoCell"
            }
          },
          "bingoCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isCompleted": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BingoCell": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "row": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "col": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "quote": {
            "$ref": "#/components/schemas/TeacherQuote"
          },
          "isMarked": {
            "type": "boolean"
          }
        }
      },
      "CreateQuoteRequest": {
        "type": "object",
        "properties": {
          "teacherId": {
            "type": "string"
          },
          "teacherName": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      },
      "TeacherQuote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "teacherId": {
            "type": "string"
          },
          "teacherName": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ToggleCellResponse": {
        "type": "object",
        "properties": {
          "board": {
            "$ref": "#/components/schemas/BingoBoard"
          },
          "newBingoAchieved": {
            "type": "boolean"
          },
          "totalBingos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "UserBingoStats": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "totalBingos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "completedBoards": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "TeacherBingo"
    }
  ]
}